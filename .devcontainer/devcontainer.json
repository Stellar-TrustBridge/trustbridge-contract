{
  "name": "TrustBridge Soroban Contract",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "onCreateCommand": "rustup target add wasm32-unknown-unknown && cargo install --locked soroban-cli || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "postAttachCommand": "soroban --version || true"
}
